// ============================================================================
// KUSINA ERP — FIRESTORE SECURITY RULES  (v2: may Access Control / Permissions)
//
// PAANO I-PUBLISH:  Firebase Console -> Firestore Database -> Rules -> i-paste -> Publish.
// BAGO MAG-PUBLISH:
//   1. KOPYAHIN MUNA ang kasalukuyang rules mo (para may babalikan).
//   2. Gamitin ang "Rules Playground" sa console para subukan ang admin, commissary at branch account.
//   3. Subukan sa test project kung maaari. Kapag may nabasag na screen, ibalik ang lumang rules.
//
// ANO ANG PINOPROTEKTAHAN:
//   - Ang ROLE ay binabasa mula sa users/{email} sa Firestore (hindi sa browser).
//   - Hindi makakapagbago ang user ng sarili niyang role / status / branch / permissions.
//   - ACCESS CONTROL: ang Admin ang nagtatakda (per role at per user) kung anong module ang
//     'none' | 'view' | 'edit'. Ginagamit din dito ang parehong setting:
//        system_settings/access_control  ->  { roles: { commissary: {employees:'view', ...}, branch: {...} } }
//        users/{email}.permissions        ->  { employees: 'edit', ... }   (nangingibabaw sa role)
//     Ang Admin role ay laging buo ang access. Ang "users" at "truncate" ay Admin lang.
//   - activity_logs, stock_movements, general_ledger = puwedeng dagdagan, hindi puwedeng baguhin/burahin.
//
// KILALANG LIMITASYON (susunod na hakbang):
//   - Nababasa pa ng lahat ng aktibong user ang lahat ng orders (walang filter sa branch ang queries ngayon).
//   - Ang pagkilala sa role ay ginagaya ang normalizeRole() ng app (may "admin/accounting/head" = admin).
//   - Ang pinakaunang admin account ay kailangang gawin sa Firebase Console (users/{email}: role "admin",
//     status "active"), dahil hindi na pinapayagan ang self-signup bilang active/admin.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pagkilala sa user at role (galing sa Firestore) ----------
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function myDocPath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function hasProfile() { return signedIn() && exists(myDocPath()); }
    function me() { return get(myDocPath()).data; }
    function active() { return hasProfile() && me().status == 'active'; }
    function roleText() { return string(me().role).lower(); }

    // Parehong pagkakasunod ng normalizeRole() sa app.js
    function superPath() { return /databases/$(database)/documents/system_settings/super_admins; }
    function isAdminRole(x) { return string(x).lower().matches('.*(admin|accounting|head).*'); }
    // Super Admin: nakalista sa system_settings/super_admins. Kung wala pang listahan, si sona101097@gmail.com lang.
    function isSuperAdmin() { return isAdmin() && (exists(superPath()) ? myEmail() in get(superPath()).data.emails : myEmail() == 'sona101097@gmail.com'); }
    function isAdmin() { return active() && roleText().matches('.*(admin|accounting|head).*'); }
    function isCommissary() {
      return active() && !roleText().matches('.*(admin|accounting|head).*')
             && roleText().matches('.*(commi|kitchen|plant).*');
    }
    function isBranch() {
      return active() && !roleText().matches('.*(admin|accounting|head).*')
             && !roleText().matches('.*(commi|kitchen|plant).*')
             && roleText().matches('.*(branch|store|outlet).*');
    }
    function isStaff() { return isAdmin() || isCommissary(); }

    // ---------- ACCESS CONTROL (permissions na itinakda ni Admin) ----------
    function accessPath() { return /databases/$(database)/documents/system_settings/access_control; }
    function roleKey() { return isCommissary() ? 'commissary' : 'branch'; }
    function roleLevel(m) {
      return exists(accessPath()) && 'roles' in get(accessPath()).data
             && roleKey() in get(accessPath()).data.roles
             && m in get(accessPath()).data.roles[roleKey()]
        ? get(accessPath()).data.roles[roleKey()][m] : 'none';
    }
    function userLevel(m) {
      return 'permissions' in me() && m in me().permissions ? me().permissions[m] : null;
    }
    function level(m) { return userLevel(m) != null ? userLevel(m) : roleLevel(m); }
    // Ang "users" at "truncate" ay hindi kailanman ipinagkakaloob (Admin lang)
    function canView(m) { return isAdmin() || (active() && (level(m) == 'view' || level(m) == 'edit')); }
    function canEdit(m) { return isAdmin() || (active() && level(m) == 'edit'); }

    // Mga grupo ng module na nagbabago ng stock
    function canStock() {
      return isStaff() || canEdit('products') || canEdit('manufacturing') || canEdit('purchase_orders')
             || canEdit('spoilage') || canEdit('lot_tracing');
    }

    // ---------- USERS ----------
    match /users/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin() || canView('memos'));
      // Bagong sign-up: sarili lang, hindi puwedeng active at hindi puwedeng admin
      allow create: if signedIn() && email == myEmail()
                    && request.resource.data.status != 'active'
                    && !string(request.resource.data.role).lower().matches('.*(admin|accounting|head).*')
                    && !('permissions' in request.resource.data);
      // Sariling profile: hindi puwedeng baguhin ang role / status / branch / permissions
      allow update: if signedIn() && email == myEmail()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'branch', 'permissions']);
      // Admin lang ang makakapag-approve, magbago ng role at permissions
      // Admin lang ang makakapag-manage ng users; ang mga admin account ay Super Admin lang ang puwedeng gumawa/mag-edit/magbura
      allow create: if isSuperAdmin() || (isAdmin() && !isAdminRole(request.resource.data.get('role', '')));
      allow update: if isSuperAdmin() || (isAdmin() && !isAdminRole(resource.data.get('role', '')) && !isAdminRole(request.resource.data.get('role', '')));
      allow delete: if isSuperAdmin() || (isAdmin() && !isAdminRole(resource.data.get('role', '')));
    }

    // ---------- PRODUKTO AT BATAYANG DATA ----------
    match /products/{id}            { allow read: if active(); allow write: if canStock(); }
    // Puhunan: staff lang (HINDI nababasa ng branch)
    match /product_costs/{id}       { allow read: if isStaff() || canView('products') || canView('manufacturing'); allow write: if isStaff() || canEdit('products') || canEdit('manufacturing'); }
    match /storage_stations/{id}    { allow read: if active(); allow write: if isAdmin() || canEdit('stations'); }
    match /uom_settings/{id}        { allow read: if active(); allow write: if isAdmin() || canEdit('stations'); }

    // ---------- BRANCH INVENTORY ----------
    match /product_photos/{id}          { allow read: if active(); allow write: if canStock() || isBranch(); }
    match /companies/{id}               { allow read: if active(); allow write: if isAdmin() || canEdit('company_mgmt') || canEdit('branch_inv'); }
    // Daily price history (may puhunan) at AR ledger: staff lang
    match /price_history/{id}           { allow read: if isStaff() || canView('daily_prices'); allow create: if isStaff() || canEdit('daily_prices'); allow update, delete: if false; }
    match /inventory_snapshots/{id}    { allow read: if isStaff() || canView('inv_totals'); allow create, update: if isStaff() || canEdit('inv_totals'); allow delete: if isAdmin(); }
    // Mga Request (repair / pagbili) — branch nakikita lang ang sarili nilang request
    function reqCfgOk() { return exists(/databases/$(database)/documents/system_settings/request_approvers); }
    function reqCfg() { return get(/databases/$(database)/documents/system_settings/request_approvers).data; }
    function reqHasList() { return reqCfgOk() && reqCfg().get('procurementList', []).size() > 0; }
    function reqTeam() { return reqCfgOk() && (myEmail() in reqCfg().get('procurementList', []) || myEmail() == reqCfg().get('cooEmail', '') || myEmail() == reqCfg().get('presidentEmail', '')); }
    match /requests/{id} {
      allow read: if isAdmin() || canView('requests') || reqTeam() || (active() && (resource.data.requesterEmail == myEmail() || resource.data.get('assigneeEmail', '') == myEmail())) || (isStaff() && !reqHasList());
      allow create: if active() && request.resource.data.requesterEmail == myEmail();
      allow update: if isAdmin() || canEdit('requests') || reqTeam() || (active() && (resource.data.requesterEmail == myEmail() || resource.data.get('assigneeEmail', '') == myEmail())) || (isStaff() && !reqHasList());
      allow delete: if isAdmin();
    }
    match /request_photos/{id}          { allow read: if active(); allow create: if active(); allow update, delete: if false; }
    match /request_counter/{id}         { allow read, write: if active(); }
    match /sap_items/{id} {
      allow read: if isStaff() || canView('sap_items');
      allow write: if isStaff() || canEdit('sap_items');
    }
    // Attendance & Schedule
    match /attendance_profiles/{id} {
      allow read: if isStaff() || canView('attendance') || (active() && (id == myEmail() || resource.data.managerEmail == myEmail()));
      allow write: if isStaff() || canEdit('attendance') || (active() && (resource.data.managerEmail == myEmail() || request.resource.data.managerEmail == myEmail()));
    }
    match /attendance_weeks/{id} {
      allow read: if isStaff() || canView('attendance') || (active() && (resource.data.email == myEmail() || resource.data.managerEmail == myEmail()));
      allow write: if isStaff() || canEdit('attendance') || (active() && (request.resource.data.managerEmail == myEmail() || resource.data.managerEmail == myEmail()));
    }
    match /attendance_logs/{id} {
      allow read: if isStaff() || canView('attendance') || (active() && (resource.data.email == myEmail() || resource.data.managerEmail == myEmail()));
      allow create, update: if isStaff() || canEdit('attendance') || (active() && request.resource.data.email == myEmail());
      allow delete: if isAdmin() || canEdit('attendance');
    }
    match /hr_documents/{id} {
      allow read: if active();
      allow write: if isAdmin() || canEdit('memos') || canEdit('hrdocs');
    }
    match /hr_doc_files/{id} {
      allow read: if active();
      allow write: if isAdmin() || canEdit('memos') || canEdit('hrdocs');
    }
    match /presence/{id} {
      allow read: if isAdmin();
      allow write: if active() && id == myEmail();
    }
    match /session_control/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /email_log/{id} {
      allow read: if isAdmin();
      allow create: if active();
      allow update, delete: if false;
    }
    match /system_health/{id} {
      allow read, write: if isAdmin();
    }
    match /memos/{id} {
      allow read: if isAdmin() || canView('memos') || (active() && myEmail() in resource.data.recipients);
      allow write: if isAdmin() || canEdit('memos');
    }
    match /memo_acks/{id} {
      allow read: if isAdmin() || canView('memos') || (active() && resource.data.email == myEmail());
      allow create: if active() && request.resource.data.email == myEmail();
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read, update: if active() && resource.data.to == myEmail();
      allow create: if active();
      allow delete: if isAdmin() || (active() && resource.data.to == myEmail());
    }
    match /attendance_photos/{id} {
      allow read: if active();
      allow create: if active();
    }
    match /attendance_requests/{id} {
      allow read: if isStaff() || canView('attendance') || (active() && (resource.data.email == myEmail() || resource.data.managerEmail == myEmail()));
      allow create: if active() && request.resource.data.email == myEmail();
      allow update: if isStaff() || canEdit('attendance') || (active() && resource.data.managerEmail == myEmail())
                    || (active() && resource.data.email == myEmail() && resource.data.status == 'Returned' && request.resource.data.email == myEmail());
      allow delete: if isAdmin();
    }
    match /ar_legacy/{id}               { allow read: if isStaff() || canView('ar_ledger'); allow create: if isStaff() || canEdit('ar_ledger'); allow update, delete: if isAdmin(); }
    match /ar_accounts/{id}             { allow read: if isStaff() || canView('ar_ledger'); allow write: if isStaff() || canEdit('ar_ledger'); }
    match /ar_payment_photos/{id}       { allow read: if isStaff() || canView('ar_ledger'); allow create: if active(); allow update, delete: if false; }
    // Bayad na isinumite ni agent (branch) — i-co-confirm ng accounting ng commissary
    match /payment_submissions/{id}     { allow read: if isStaff() || canView('ar_ledger') || (active() && resource.data.byEmail == myEmail());
                                          allow create: if active() && request.resource.data.byEmail == myEmail() && request.resource.data.status == 'pending';
                                          allow update: if isStaff() || canEdit('ar_ledger');
                                          allow delete: if false; }
    match /price_lists/{id}             { allow read: if active(); allow write: if isAdmin() || canEdit('price_lists') || canEdit('company_mgmt') || canEdit('products'); }
    match /branch_stations/{id}         { allow read: if active(); allow write: if isAdmin() || canEdit('branch_inv'); }
    match /inventory_branches/{id}      { allow read: if active(); allow write: if isAdmin() || canEdit('branch_inv'); }
    match /inventory_items/{id} {
      allow read: if active();
      allow create, update: if isAdmin() || canEdit('branch_inv') || isBranch();
      allow delete: if isAdmin() || canEdit('branch_inv');
    }
    match /inventory_counts/{id} {
      allow read: if active();
      allow create: if isAdmin() || isBranch() || canEdit('branch_inv');
      allow update: if isAdmin() || canEdit('branch_inv') || (isBranch() && resource.data.status != 'approved');
      allow delete: if isAdmin();
    }
    match /inventory_costs/{id} {
      allow read: if active();
      allow write: if isAdmin() || isBranch() || canEdit('branch_inv');
    }
    match /inventory_markouts/{id} {
      allow read: if active();
      allow write: if isAdmin() || isBranch() || canEdit('branch_inv');
    }
    match /inventory_bom/{id} {
      allow read: if active();
      allow write: if isAdmin() || isBranch() || canEdit('branch_inv');
    }
    match /inventory_station_map/{id} {
      allow read: if active();
      allow write: if isAdmin() || isBranch() || canEdit('branch_inv');
    }
    match /inventory_item_requests/{id} {
      allow read: if active();
      allow create: if isAdmin() || isBranch() || isCommissary();
      allow update: if isAdmin() || isCommissary() || canEdit('branch_inv');
      allow delete: if isAdmin();
    }
    match /commissary_hubs/{id}     { allow read: if active(); allow write: if isAdmin() || canEdit('stations'); }
    match /commissary_team/{id}     { allow read: if active(); allow write: if isStaff() || canEdit('team'); }
    match /customers/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin() || canEdit('customers');
    }
    match /bom_recipes/{id} {
      allow read: if isStaff() || canView('manufacturing') || canView('costing');
      allow write: if isAdmin() || canEdit('manufacturing');
    }
    match /product_backups/{id} {
      allow read: if canView('backups');
      allow create: if canEdit('backups') || canEdit('products');
      allow update, delete: if canEdit('backups');
    }
    match /product_logs/{id}        { allow read: if canView('logs'); allow create: if active(); }

    // ---------- ORDERS AT DISPUTES ----------
    match /orders/{id} {
      allow read: if active();   // TODO: i-lock sa sariling branch kapag naayos na ang branch queries
      allow create: if isStaff()
                    || (isBranch() && request.resource.data.branchEmail.lower() == myEmail());
      allow update: if isStaff() || canEdit('disputes')
                    || (isBranch() && resource.data.branchEmail.lower() == myEmail());
      allow delete: if isAdmin();
    }
    match /disputes/{id} {
      allow read: if active();
      allow create: if active();
      allow update, delete: if isStaff() || canEdit('disputes');
    }

    // ---------- STOCK ----------
    match /stock_movements/{id} {
      allow read: if isStaff() || canView('products') || canView('logs');
      allow create: if canStock();
      allow update, delete: if false;      // tala ng galaw ng stock: hindi mababago
    }
    match /spoilage_requests/{id} {
      allow read: if isStaff() || canView('spoilage');
      allow create: if isStaff() || canEdit('spoilage');
      allow update, delete: if isAdmin() || canEdit('spoilage');
    }
    match /inventory_lots/{id}      { allow read: if isStaff() || canView('lot_tracing'); allow write: if isStaff() || canEdit('lot_tracing'); }
    match /assets/{id}              { allow read: if canView('assets'); allow write: if canEdit('assets'); }

    // ---------- PERA / HR / VENDOR ----------
    match /vendors/{id}             { allow read: if active(); allow write: if isAdmin() || canEdit('vendors'); }
    match /vendor_pos/{id} {
      allow read: if isStaff() || canView('purchase_orders') || canView('ap_invoices') || canView('auto_pr');
      allow create: if isStaff() || canEdit('purchase_orders') || canEdit('auto_pr');
      allow update, delete: if isAdmin() || canEdit('purchase_orders') || canEdit('ap_invoices');
    }
    match /general_ledger/{id} {
      allow read: if canView('finance') || canView('ap_invoices') || canView('payroll');
      allow create: if canEdit('finance') || canEdit('ap_invoices') || canEdit('payroll');
      allow update, delete: if false;       // hindi binabago ang ledger; adjustment entry lang
    }
    match /employees/{id} {
      allow read: if canView('employees') || canView('payroll');
      allow write: if canEdit('employees');
      // NBI, Police, Barangay, atbp. (litrato / PDF)
      match /documents/{docId} {
        allow read: if canView('employees');
        allow write: if canEdit('employees');
      }
    }
    match /payrolls/{id} {
      allow read: if canView('payroll');
      allow write: if canEdit('payroll');
    }

    // ---------- SETTINGS ----------
    match /system_settings/{id} {
      allow read: if active();              // branding, SI sequence, access_control, atbp.
      allow write: if (isAdmin() && id != 'super_admins' && id != 'menu_visibility')
                   || ((id == 'super_admins' || id == 'menu_visibility') && isSuperAdmin())
                   || (isCommissary() && id == 'invoice_sequence')
                   || (id == 'branding' && canEdit('branding'))
                   || (id == 'attendance_presets' && canEdit('attendance'))
                   || (id == 'finance_balances' && canEdit('finance'));
      // Ang 'access_control' ay Admin lang (isAdmin() sa itaas ang tanging nakakapag-sulat nito)
    }

    // ---------- PRIME COST (weekly, kada branch) ----------
    match /pc_weeks/{id}   { allow read: if isAdmin() || isBranch() || canView('prime'); allow write: if isAdmin() || isBranch() || canEdit('prime'); }
    match /pc_setup/{id}   { allow read: if active(); allow write: if isAdmin(); }
    match /pc_rates/{id}   { allow read: if active(); allow write: if isAdmin(); }
    match /pc_ratesecure/{id} { allow read, write: if isAdmin(); }
    match /pc_actual/{id}  { allow read: if isAdmin() || isBranch(); allow write: if isAdmin(); }

    // ---------- LST (schedule / manning / bio) ----------
    match /lst_setup/{id} { allow read: if canView('lst'); allow write: if canEdit('lst'); }
    match /lst_weeks/{id} { allow read: if canView('lst'); allow write: if canEdit('lst'); }
    match /lst_bio/{id}   { allow read: if canView('lst'); allow write: if canEdit('lst'); }

    // ---------- AUDIT LOG ----------
    match /activity_logs/{id} {
      allow read: if canView('logs');
      allow create: if active();
      allow update, delete: if false;
    }

    // ---------- Lahat ng iba: bawal ----------
    match /{document=**} { allow read, write: if false; }
  }
}
