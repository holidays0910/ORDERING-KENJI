// ============================================================================
// KUSINA ERP — FIRESTORE SECURITY RULES
//
// PAANO I-PUBLISH:  Firebase Console -> Firestore Database -> Rules -> i-paste -> Publish.
// BAGO MAG-PUBLISH:
//   1. KOPYAHIN MUNA ang kasalukuyang rules mo (para may babalikan).
//   2. Gamitin ang "Rules Playground" sa console para subukan ang admin, commissary at branch account.
//   3. Subukan sa test project kung maaari. Kapag may nabasag na screen, ibalik ang lumang rules.
//
// ANO ANG PINOPROTEKTAHAN:
//   - Ang ROLE ay binabasa mula sa users/{email} sa Firestore (hindi sa browser), kaya hindi na
//     makakapag-ayos ang user ng sarili niyang role sa localStorage.
//   - Hindi makakapagbago ang user ng sarili niyang role / status / branch.
//   - Pera at HR (general_ledger, payrolls, employees, vendors, vendor_pos) = admin lang.
//   - activity_logs at stock_movements = puwedeng dagdagan, hindi puwedeng baguhin o burahin.
//
// KILALANG LIMITASYON (susunod na hakbang):
//   - Nababasa pa ng lahat ng aktibong user ang lahat ng orders, dahil naglo-load ang branch ng
//     orders nang walang filter sa branch. Para ma-lock ito, papalitan muna ang queries ng branch
//     (where branchEmail == email) at magdadagdag ng index.
//   - Ang pagkilala sa role ay ginagaya ang normalizeRole() ng app (may "admin/accounting/head" = admin).
//     Kaya ang role na may salitang "head" (hal. "Commissary Head") ay ituturing na admin, gaya sa app ngayon.
//   - Ang pinakaunang admin account ay kailangang gawin mismo sa Firebase Console (users/{email} na may
//     role "admin" at status "active"), dahil hindi na pinapayagan ang self-signup bilang active/admin.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pagkilala sa user at role (galing sa Firestore) ----------
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function myDocPath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function hasProfile() { return signedIn() && exists(myDocPath()); }
    function me() { return get(myDocPath()).data; }
    function active() { return hasProfile() && me().status == 'active'; }
    function roleText() { return string(me().role).lower(); }

    // Parehong pagkakasunod ng normalizeRole() sa app.js
    function isAdmin() { return active() && roleText().matches('.*(admin|accounting|head).*'); }
    function isCommissary() {
      return active() && !roleText().matches('.*(admin|accounting|head).*')
             && roleText().matches('.*(commi|kitchen|plant).*');
    }
    function isBranch() {
      return active() && !roleText().matches('.*(admin|accounting|head).*')
             && !roleText().matches('.*(commi|kitchen|plant).*')
             && roleText().matches('.*(branch|store|outlet).*');
    }
    function isStaff() { return isAdmin() || isCommissary(); }

    // ---------- USERS ----------
    match /users/{email} {
      // Sariling profile, o admin lahat
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      // Bagong sign-up: sarili lang, hindi puwedeng active at hindi puwedeng admin
      allow create: if signedIn() && email == myEmail()
                    && request.resource.data.status != 'active'
                    && !string(request.resource.data.role).lower().matches('.*(admin|accounting|head).*');
      // Sariling profile: hindi puwedeng baguhin ang role / status / branch
      allow update: if signedIn() && email == myEmail()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'branch']);
      // Admin: puwedeng i-approve / baguhin ang lahat
      allow update, delete: if isAdmin();
      allow create: if isAdmin();
    }

    // ---------- PRODUKTO AT BATAYANG DATA ----------
    match /products/{id}            { allow read: if active(); allow write: if isStaff(); }
    match /storage_stations/{id}    { allow read: if active(); allow write: if isAdmin(); }
    match /uom_settings/{id}        { allow read: if active(); allow write: if isAdmin(); }
    match /commissary_team/{id}     { allow read: if active(); allow write: if isStaff(); }
    match /customers/{id}           { allow read: if active(); allow create, update: if active(); allow delete: if isAdmin(); }
    match /bom_recipes/{id}         { allow read: if isStaff(); allow write: if isAdmin(); }
    match /product_backups/{id}     { allow read, write: if isAdmin(); }
    match /product_logs/{id}        { allow read: if isAdmin(); allow create: if active(); }

    // ---------- ORDERS AT DISPUTES ----------
    match /orders/{id} {
      allow read: if active();   // TODO: i-lock sa sariling branch kapag naayos na ang branch queries
      allow create: if isStaff()
                    || (isBranch() && request.resource.data.branchEmail.lower() == myEmail());
      allow update: if isStaff()
                    || (isBranch() && resource.data.branchEmail.lower() == myEmail());
      allow delete: if isAdmin();
    }
    match /disputes/{id} {
      allow read: if active();
      allow create: if active();
      allow update, delete: if isStaff();
    }

    // ---------- STOCK ----------
    match /stock_movements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;      // tala ng galaw ng stock: hindi mababago
    }
    match /spoilage_requests/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /inventory_lots/{id}      { allow read: if isStaff(); allow write: if isStaff(); }
    match /assets/{id}              { allow read, write: if isAdmin(); }

    // ---------- PERA / HR / VENDOR (admin lang) ----------
    match /vendors/{id}             { allow read: if active(); allow write: if isAdmin(); }
    match /vendor_pos/{id} {
      allow read: if isStaff();
      allow create: if isStaff();           // direct receiving ng commissary
      allow update, delete: if isAdmin();
    }
    match /general_ledger/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;       // hindi binabago ang ledger; adjustment entry lang
    }
    match /employees/{id}           { allow read, write: if isAdmin(); }
    match /payrolls/{id}            { allow read, write: if isAdmin(); }

    // ---------- SETTINGS ----------
    match /system_settings/{id} {
      allow read: if active();              // branding, SI sequence, atbp.
      allow write: if isAdmin() || (isCommissary() && id == 'invoice_sequence');
    }

    // ---------- AUDIT LOG ----------
    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow create: if active();
      allow update, delete: if false;
    }

    // ---------- Lahat ng iba: bawal ----------
    match /{document=**} { allow read, write: if false; }
  }
}
